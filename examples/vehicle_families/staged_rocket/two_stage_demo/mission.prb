(sr-a-two-stage-demo)
*title Synthetic two-stage point-mass family smoke test
*atmos none
*earth spherical gm=0 omega=0

*trajectory 1 stack start on 10
  *initial geodetic alt=0 long=0 lat=0 vel=0 gama=45 psi=90 time=0 wt=1000
  *file stack.dat time tseg tmark plength vel wt thrust

  *segment 10 first stage powered flight
    *integ dtprnt=0.1 dt=0.01
    *reset tmark=0
    *aero ca=(sr-a-stage1-on)
    *prop thrust=(sr-a-stage1-thrust) mdot=(sr-a-stage1-mdot)
    *rail launch cfstat=0.15 cfslid=0.01
    *when plength>20 goto 20

  *segment 20 separation and coast
    *integ dtprnt=0.1 dt=0.02
    *increment wt=-250
    *aero ca=(sr-a-stage1-off)
    *when tseg>0.5 goto 30

  *segment 30 second stage powered flight
    *integ dtprnt=0.1 dt=0.01
    *reset wt=500 tmark=0
    *aero ca=(sr-a-stage2-on)
    *prop thrust=(sr-a-stage2-thrust) mdot=(sr-a-stage2-mdot)
    *when tseg>3 goto 40

  *segment 40 payload coast
    *integ dtprnt=0.1 dt=0.02
    *aero ca=(sr-a-stage2-off)
    *when tseg>1 stop

*trajectory 2 discarded booster start on 1
  *initial from trajectory 1, segment 20
  *file booster.dat time tseg vel wt
  *segment 1 discarded-stage coast
    *reset wt=250
    *aero ca=(sr-a-booster-tumble)
    *when tseg>1 stop

*end
