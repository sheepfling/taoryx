(x15-weave-bank-energy-management-6dof)
*title X-15 source-deck multi-cycle bank weave checkpoint
*mode rigid-body-6dof
*atmos standard
*earth wgs-84 omega=7.2921151467e-5 gm=3.986004418e14
*runtime status vehicle=x15 family=unpowered_hypersonic_glider maneuver=weave bank-amplitude-deg=10 cycles=2
*runtime status vehicle reference-area=18.580608 reference-length=3.130296 inertia-x=4948.7355 inertia-y=129114.2666 inertia-z=131825.9024 dry-mass-kg=14641.0545 envelope-max-mach=6.7 envelope-max-alpha-deg=10 envelope-max-beta-deg=10
*runtime status actuator maximum-moment=250000 maximum-body-rate-deg-s=3600
*runtime control bank-deg vehicle=1 default=0.0 lower=-10.0 upper=10.0

*trajectory 1 glider start on 1
  *initial ecic x=-2550174.732106006 y=-4630503.055917352 z=3606993.764430032 xdt=-882.369500802 ydt=680.596575558 zdt=636.70629759 qw=0.332761597086 qx=-0.0923464597563 qy=-0.712620308262 qz=0.610666969082 wx=0.178322831283 wy=0.13481920873 wz=-0.22509452394 time=0.0 mass=14641.0545 propellant_mass=0.0
  *file x15_weave_6dof.dat time altitude_m speed_m_s range_to_target_m aero_alpha_deg aero_sideslip_deg mass_kg _segment
  *segment 1 positive-bank-1
    *integ dtprnt=1.0 dt=0.0125
    *prop thrust=0 mdot=0
    *aero cx=(cx) cy=(cy) cz=(cz) cmx=(cmx) cmy=(cmy) cmz=(cmz)
    *fly bankgc=10
    *when time>10 goto 2
  *segment 2 negative-bank-1
    *integ dtprnt=1.0 dt=0.0125
    *prop thrust=0 mdot=0
    *aero cx=(cx) cy=(cy) cz=(cz) cmx=(cmx) cmy=(cmy) cmz=(cmz)
    *fly bankgc=-10
    *when time>20 goto 3
  *segment 3 positive-bank-2
    *integ dtprnt=1.0 dt=0.0125
    *prop thrust=0 mdot=0
    *aero cx=(cx) cy=(cy) cz=(cz) cmx=(cmx) cmy=(cmy) cmz=(cmz)
    *fly bankgc=10
    *when time>30 goto 4
  *segment 4 negative-bank-2
    *integ dtprnt=1.0 dt=0.0125
    *prop thrust=0 mdot=0
    *aero cx=(cx) cy=(cy) cz=(cz) cmx=(cmx) cmy=(cmy) cmz=(cmz)
    *fly bankgc=-10
    *when time>40 goto 5
  *segment 5 neutral-bank-glide
    *integ dtprnt=1.0 dt=0.0125
    *prop thrust=0 mdot=0
    *aero cx=(cx) cy=(cy) cz=(cz) cmx=(cmx) cmy=(cmy) cmz=(cmz)
    *fly bankgc=0
    *when time>90 stop
*end
