(slower-x8-sv03-figure-eight-altitude-reversal-6dof)
*title Skywalker X8 powered figure-eight bank and pitch reversal showcase
*mode rigid-body-6dof
*atmos standard
*earth wgs-84 omega=0
*runtime status vehicle reference-area=0.75 reference-length=0.36 dry-mass-kg=3.364 inertia-x=0.325 inertia-y=0.140 inertia-z=0.400 envelope-min-forward-speed=2 envelope-max-speed=27 envelope-max-alpha-deg=12 envelope-max-beta-deg=5
*runtime status target latitude-deg=0.0 longitude-deg=0.0 altitude-m=178.0
*runtime status route mode=figure-eight start-latitude-deg=0.0 start-longitude-deg=0.0 duration-s=180.0 start-altitude-m=178.0 figure-eight-length-m=600 figure-eight-width-m=300 figure-eight-speed-mps=20.0 figure-eight-bank-deg=12 figure-eight-pitch-deg=16.0 figure-eight-altitude-amplitude-m=8.0 position-capture-gain=0.05 position-capture-max-correction-mps=8.0 terminal-capture=true terminal-start-s=140.0 terminal-target-altitude-m=178.0 terminal-capture-gain=0.4 terminal-velocity-damping=0.3 terminal-altitude-gain=0.8 terminal-radial-damping=0.8 terminal-speed-mps=20.0 terminal-heading-deg=90.0 terminal-command-speed-mps=25.0
*runtime status guidance propnav-gain=0.0 figure-eight-coordinated-turn=true max-sideslip-deg=4.0 max-pitch-deg=5.0 collective-elevon-hold-gain-deg-per-deg=0.5 collective-elevon-hold-target-deg=7.9 collective-elevon-min-deg=-20 collective-elevon-max-deg=20 differential-elevon-hold-gain-deg-per-deg=0.5 differential-elevon-hold-target-deg=0.0 differential-elevon-min-deg=-20 differential-elevon-max-deg=20 sideslip-gain=-12.0 sideslip-rate-damping=2.5 body-rate-damping-nm-s-per-rad=0.1
*runtime status actuator maximum-moment=20 maximum-body-rate-deg-s=180
*runtime lqr attitude states=attitude-error-x,attitude-error-y,attitude-error-z,wx,wy,wz controls=moment-x,moment-y,moment-z q-angle=3.0 q-rate=1.0 r-moment=0.5 method=continuous update=initial
*runtime control collective-elevon-deg vehicle=1 default=-2.35 lower=-20 upper=20
*runtime control differential-elevon-deg vehicle=1 default=-2.16 lower=-20 upper=20
*runtime control throttle vehicle=1 default=0.7407992605852429 lower=0 upper=1
*define x8-cx
  x8-cx=(cx-static)+(cx-collective)-(cx-static)+(cx-differential)-(cx-static);
*define x8-cy
  x8-cy=(cy-static)+(cy-collective)-(cy-static)+(cy-differential)-(cy-static);
*define x8-cz
  x8-cz=(cz-static)+(cz-collective)-(cz-static)+(cz-differential)-(cz-static);
*define x8-cmx
  x8-cmx=(cmx-static)+(cmx-collective)-(cmx-static)+(cmx-differential)-(cmx-static);
*define x8-cmy
  x8-cmy=(cmy-static)+(cmy-collective)-(cmy-static)+(cmy-differential)-(cmy-static);
*define x8-cmz
  x8-cmz=(cmz-static)+(cmz-collective)-(cmz-static)+(cmz-differential)-(cmz-static);
*trajectory 1 x8 start on 1
  *initial ecic x=6378315.0 y=0.0 z=0.0 xdt=0.0 ydt=17.9 zdt=0.0 qw=0.5332552264 qx=-0.5332552264 qy=-0.4643693180 qz=0.4643693180 time=0.0 mass=3.364 propellant_mass=0.0
  *segment 1 figure-eight-altitude-reversal
    *integ dtprnt=0.2 dt=0.02
    *prop thrust=(thrust) mdot=0
    *aero cx=x8-cx cy=x8-cy cz=x8-cz cmx=x8-cmx cmy=x8-cmy cmz=x8-cmz
    *fly propnav=4
    *when time>360.0 stop
*end
