(slower-x8-sv03-controller-recovery-10-6dof)
*title Skywalker X8 generated 10-second powered controller recovery
*mode rigid-body-6dof
*atmos standard
*earth wgs-84 omega=0.0
*runtime status vehicle reference-area=0.75 reference-length=0.36 dry-mass-kg=3.364 nominal-mass-kg=3.364 inertia-x=0.325 inertia-y=0.14 inertia-z=0.4 envelope-min-forward-speed=2 envelope-max-speed=27 envelope-max-alpha-deg=12 envelope-max-beta-deg=5
*runtime control throttle vehicle=1 default=0.6265437663082247 lower=0 upper=1
*runtime control collective-elevon-deg vehicle=1 default=-2.35 lower=-20 upper=20
*runtime control differential-elevon-deg vehicle=1 default=-2.16 lower=-20 upper=20

*runtime status target altitude-m=178.0

*runtime status guidance attitude-gain=500.0 rate-damping=10.0 flight-path-hold-target-deg=0.0 flight-path-hold-altitude-gain-deg-per-m=0.5 flight-path-hold-max-target-deg=10.0 collective-elevon-hold-gain-deg-per-deg=0.5 collective-elevon-hold-target-deg=7.9 collective-elevon-min-deg=-20 collective-elevon-max-deg=20 differential-elevon-hold-gain-deg-per-deg=0.5 differential-elevon-hold-target-deg=0.0 differential-elevon-min-deg=-20 differential-elevon-max-deg=20 sideslip-gain=50.0 sideslip-rate-damping=1.0 body-rate-damping-nm-s-per-rad=0.1 airspeed-hold-target-mps=18.0 airspeed-hold-gain-throttle-per-mps=0.15 airspeed-hold-min-throttle=0.35 airspeed-hold-max-throttle=0.85
*runtime status actuator maximum-moment=100 maximum-body-rate-deg-s=180
*runtime status thermal policy=none
# X8 control tables contain absolute total coefficients at throttle=0.44;
# the static table is zero-throttle, so zero-control values differ.
# Subtract the common static term before adding each control contribution;
# do not simplify or remove terms.
# Composition: static + (collective - static) + (differential - static).
*define x8-cx
  x8-cx=(cx-static)+(cx-collective)-(cx-static)+(cx-differential)-(cx-static);
*define x8-cy
  x8-cy=(cy-static)+(cy-collective)-(cy-static)+(cy-differential)-(cy-static);
*define x8-cz
  x8-cz=(cz-static)+(cz-collective)-(cz-static)+(cz-differential)-(cz-static);
*define x8-cmx
  x8-cmx=(cmx-static)+(cmx-collective)-(cmx-static)+(cmx-differential)-(cmx-static);
*define x8-cmy
  x8-cmy=(cmy-static)+(cmy-collective)-(cmy-static)+(cmy-differential)-(cmy-static);
*define x8-cmz
  x8-cmz=(cmz-static)+(cmz-collective)-(cmz-static)+(cmz-differential)-(cmz-static);

*trajectory 1 x8 start on 1
  *initial ecic x=6378315.0 y=0.0 z=0.0 xdt=0.0 ydt=17.9 zdt=0.0 qw=0.5332552264 qx=-0.5332552264 qy=-0.4643693180 qz=0.4643693180 time=0.0 mass=3.364 propellant_mass=0.0
  *segment 1 controller-recovery-10
    *integ dtprnt=0.05 dt=0.005
    *prop thrust=(thrust) mdot=0
    # Aero channels are body-axis cx/cy/cz (not direct CD/CL); X8 control decks are absolute total values at throttle=0.44, distinct from the zero-throttle static deck, and are composed by the explicit formula.
    *aero cx=x8-cx cy=x8-cy cz=x8-cz cmx=x8-cmx cmy=x8-cmy cmz=x8-cmz


    *when time>10.0 stop
*end
