(generic-cruise-demo)
*title Generic cruise dataset demonstration
*atmos none
*earth wgs-84 omega=0
*trajectory 1 vehicle start on 1
  *initial geodetic alt=5000.0 long=0.0 lat=0.0 vel=180.0 gama=0.0 psi=0.0 time=0.0 mass=1200.0
  *define cruise_thrust
    cruise_thrust = table(demo-jet-thrust);
  *define cruise_mdot
    cruise_mdot = table(demo-jet-mdot);
  *define clean_lift
    clean_lift = table(demo-clean-cl);
  *define clean_drag
    clean_drag = table(demo-clean-cd);
  *define flap_lift_increment
    flap_lift_increment = table(demo-flap-dcl);
  *define flap_drag_increment
    flap_drag_increment = table(demo-flap-dcd);
  *define speedbrake_drag_increment
    speedbrake_drag_increment = table(demo-speedbrake-dcd);
  *define cg_location
    cg_location = table(demo-cg);
  *file generic-cruise-demo.dat time alt mach throttle cruise_thrust cruise_mdot clean_lift clean_drag flap_lift_increment flap_drag_increment speedbrake_drag_increment cg_location xecfcdt
  *segment 1 cruise
    *integ dtprnt=0.1 dt=0.1
    *constants throttle=0.5 flaps=20 speedbrake=0.0 alpha_deg=3.0
    *fly mach=0.6
    *prop thrust=(demo-jet-thrust) mdot=(demo-jet-mdot)
    *aero cl=(demo-clean-cl)
    *aero cd=(demo-clean-cd)
    *when time>0.3 stop
*end
