(simple_aero-crossrange)

# Synthetic TAOS translation of tests/fixtures/simple_aero_v1/crossrange.yaml
# Simple Aero family: crossrange
# Start controls: initial_heading_error_deg
# Stop controls: min_time_to_go_s

*title Simple Aero translation crossrange

*atmos standard
*earth wgs-84 omega=0

*trajectory 1 vehicle start on 1
  *initial geodetic alt=0.0 long=14.4425 lat=35.8766 vel=10.0 gama=0.0 psi=105.0 time=0.0 mass=100.0
  *file crossrange.dat time alt vel gamgd alpha bankgd thrust
  *segment 1 crossrange
    *integ dtprnt=0.1 dt=0.1
    *aero ca=0.0 cn=0.0
    *fly bankgd=15.0
    *when time=60.0 stop

*end
