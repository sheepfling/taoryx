(simple_aero-slalom)

# Synthetic TAOS translation of tests/fixtures/simple_aero_v1/slalom.yaml
# Simple Aero family: slalom
# Start controls: start_range_to_go_km
# Stop controls: end_range_to_go_km, min_time_to_go_s

*title Simple Aero translation slalom

*atmos standard
*earth wgs-84 omega=0

*trajectory 1 vehicle start on 1
  *initial geodetic alt=0.0 long=14.4425 lat=35.8766 vel=10.0 gama=0.0 psi=90.0 time=0.0 mass=100.0
  *file slalom.dat time alt vel gamgd alpha thrust
  *segment 1 slalom
    *integ dtprnt=0.1 dt=0.1
    *aero ca=0.0 cn=0.0
    *fly alpha=0.0
    *when time=60.0 stop

*end
