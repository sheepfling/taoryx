(simple_aero-cbcr)

# Synthetic TAOS translation of tests/fixtures/simple_aero_v1/cbcr.yaml
# Simple Aero family: cbcr
# Start controls: go_left, maneuver_altitude_start_km
# Stop controls: maneuver_duration_s, min_time_to_go_s

*title Simple Aero translation cbcr left turn

*atmos standard
*earth wgs-84 omega=0

*trajectory 1 vehicle start on 1
  *initial geodetic alt=0.0 long=14.4425 lat=35.8766 vel=10.0 gama=0.0 psi=90.0 time=0.0 mass=100.0
  *file cbcr.dat time alt vel gamgd alpha bankgd thrust
  *segment 1 cbcr
    *integ dtprnt=0.1 dt=0.1
    *aero ca=0.0 cn=0.0
    *fly bankgd=-15.0
    *when time=35.0 stop

*end
