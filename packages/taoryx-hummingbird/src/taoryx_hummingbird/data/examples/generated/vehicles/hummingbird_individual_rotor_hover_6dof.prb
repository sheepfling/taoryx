(hummingbird-individual-rotor-hover-6dof)
*title Hummingbird individual-rotor source hover plant
*mode rigid-body-6dof
*atmos standard
*earth wgs-84 omega=0.0

# This source path is intentionally stronger than the legacy common-speed
# direct-wrench reduction.  The individual rotor commands below drive the
# extracted RotorPy force/moment equations directly: thrust, rotor drag,
# force arms, reaction torque, and first-order motor response are all declared
# by the physical-LQR tool.  It remains a local hover operating-point anchor,
# not a battery/endurance or blade-resolved model.
*runtime status vehicle reference-area=1.0 reference-length=0.34 dry-mass-kg=0.5 nominal-mass-kg=0.5 inertia-x=0.00365 inertia-y=0.00368 inertia-z=0.00703 envelope-max-speed=10 aero-load-mode=direct-wrench aero-wrench-frame=source-z-up rotor-allocation=quad-x rotor-force-model=individual-rotor-source rotor-arm-m=0.17 rotor-thrust-coefficient=5.57e-6 rotor-reaction-torque-coefficient=1.36e-7 rotor-drag-xy-coefficient=0.000119 rotor-drag-z-coefficient=0.000232 rotor-translational-lift-coefficient=0.00339 rotor-frame-drag-x-coefficient=0.005 rotor-frame-drag-y-coefficient=0.005 rotor-frame-drag-z-coefficient=0.01 rotor-speed-min=0 rotor-speed-max=1500 aero-source-quality=source-derived
*runtime control rotor-speed vehicle=1 default=469.124102661955 lower=0 upper=1500
*runtime control rotor-1-speed vehicle=1 default=469.124102661955 lower=0 upper=1500
*runtime control rotor-2-speed vehicle=1 default=469.124102661955 lower=0 upper=1500
*runtime control rotor-3-speed vehicle=1 default=469.124102661955 lower=0 upper=1500
*runtime control rotor-4-speed vehicle=1 default=469.124102661955 lower=0 upper=1500
*runtime status actuator maximum-moment=1 maximum-body-rate-deg-s=720 motor-model=first-order-motor-lag motor-time-constant-s=0.005 motor-speed-min-rad-s=0 motor-speed-max-rad-s=1500 motor-source=rotorpy-hummingbird-validity
*runtime status thermal policy=none

*trajectory 1 hummingbird start on 1
  *initial ecic x=6378139.0 y=0.0 z=0.0 xdt=0.0 ydt=0.0 zdt=0.0 qw=0.5 qx=-0.5 qy=-0.5 qz=0.5 time=0.0 mass=0.5 propellant_mass=0.0
  *segment 1 individual-rotor-hover
    *integ dtprnt=0.01 dt=0.001
    *aero cx=(cx) cy=(cy) cz=(cz) cmx=(cmx) cmy=(cmy) cmz=(cmz)
    *when time>5.0 stop
*end
