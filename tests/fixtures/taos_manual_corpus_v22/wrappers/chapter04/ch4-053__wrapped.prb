(corpus-ch4-053)
*trajectory 1 vehicle start on 1
  *define stag-heat
    rnose = 1.0 / 12.0;
    stag-heat = (17600.0/sqrt(rnose))*sqrt(rho/0.0023769)
                * (vel/26000.0)^3.15;
  *initial geodetic
    long=0 lat=0 alt=0 vel=0 gama=0 psi=90 time=0 wt=1
  *segment 1 test
    *when time>1 stop
*end
