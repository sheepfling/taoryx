(air-breathing-runtime-harness)
*title Air-breathing deck runtime harness
*atmos none
*earth wgs-84 omega=0
*trajectory 1 vehicle start on 1
  *initial geodetic alt=5000.0 long=0.0 lat=0.0 vel=550.0 gama=0.0 psi=0.0 time=0.0 mass=1200.0
  *define turbojet_thrust_sample
    turbojet_thrust_sample = table(small-turbojet-thrust);
    turbojet_mdot_sample = table(small-turbojet-mdot);
    throttle_limited_thrust_sample = table(throttle-limited-thrust);
    throttle_limited_mdot_sample = table(throttle-limited-mdot);
    afterburning_thrust_sample = table(afterburning-thrust);
    afterburning_mdot_sample = table(afterburning-mdot);
    inlet_recovery_sample = table(inlet-recovery);
  *file air-breathing-runtime.dat time mach alt throttle thrust mdot turbojet_thrust_sample turbojet_mdot_sample throttle_limited_thrust_sample throttle_limited_mdot_sample afterburning_thrust_sample afterburning_mdot_sample inlet_recovery_sample xecfcdt
  *segment 1 cruise
    *integ dtprnt=0.1 dt=0.1
    *constants throttle=0.5 alpha_deg=10.0
    *fly mach=0.6
    *prop thrust=(small-turbojet-thrust) mdot=(small-turbojet-mdot)
    *when time>0.2 stop
*end
