(spectre-propnav)

# Synthetic TAOS trajectory translation of the proportional-navigation e2e case
# Working set: shared launch/target, boost, coast-to-apogee, maneuver, terminal pronav

# Spectre metadata:
# family: ProportionalNavigation
# terminal_handoff_range_km: 20.0
# notes:
#   - interceptor/target pair

*title Spectre-like propnav intercept

*atmos none
*earth spherical gm=0 omega=0

*trajectory 1 interceptor start on 1

  *initial ecfc x=20925646.3255 y=0 z=0 xdt=0 ydt=0 zdt=0 time=0 mass=5

  *file interceptor.dat time xecfc yecfc relrng[2] relvel[2] yawi pitchi
  *segment 1 boost
    *integ dtprnt=0.25 dt=0.025 dtguid=3
    *inertial ecfc
    *prop thrust=(interceptor-thrust) mdot=(zero-mdot)
    *when z<0 stop
    *when tseg=5 goto 2
  *segment 2 coast_to_apogee
    *integ dtprnt=0.25 dt=0.025
    *inertial ecfc
    *when z<0 stop
    *when tseg=40 goto 3
  *segment 3 maneuver
    *integ dtprnt=0.25 dt=0.025 dtguid=3
    *inertial ecfc
    *prop thrust=(interceptor-thrust) mdot=(zero-mdot)
    *fly yawi=0.0 pitchi=0.0
    *when z<0 stop
    *when tseg=60 goto 4
  *segment 4 terminal_pronav
    *integ dtprnt=0.25 dt=0.025 dtguid=3
    *inertial ecfc
    *prop thrust=(interceptor-thrust) mdot=(zero-mdot)
    # 20 km to go handoff
    *fly propnav=2
    *when relrng[2]<20000 stop
    *when time=20 stop
    *when z<0 stop

*trajectory 2 target start on 1

  *initial ecfc x=20925646.3255 y=1000 z=0 xdt=0 ydt=10 zdt=0 time=0 mass=1

  *file target.dat time xecfc yecfc
  *segment 1 coast
    *integ dtprnt=0.25 dt=0.025
    *when z<0 stop
    *when time=20 stop

*end
