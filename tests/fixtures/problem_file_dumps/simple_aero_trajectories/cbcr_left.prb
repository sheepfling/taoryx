(simple_aero-cbcr-left)

# Synthetic TAOS trajectory translation of tests/fixtures/simple_aero_v1/cbcr.yaml
# Working set: boost, coast-to-apogee, maneuver, terminal propnav

# Simple Aero metadata:
# family: CBCR
# direction: left
# maneuver_altitude_start_km: 40.0
# maneuver_duration_s: 35.0
# min_time_to_go_s: 60.0

*title Simple Aero-like CBCR left turn

*atmos standard
*earth wgs-84 omega=0

*trajectory 1 vehicle start on 1

  *initial geodetic alt=0.0 long=14.4425 lat=35.8766 vel=10.0 gama=0.0 psi=90.0 time=0.0 wt=1000.0

  *file cbcr-left.dat time alt vel gamgd alpha bankgd thrust
  *segment 1 boost
    *integ dtprnt=0.1 dt=0.01
    *prop thrust=(stage1-thrust) mdot=(stage1-mdot)
    *when tseg=5 goto 2
  *segment 2 coast_to_apogee
    *integ dtprnt=0.5 dt=0.05
    *aero ca=(coast-ca) cn=(coast-cn)
    *when alt<0 stop
    *when tseg=40 goto 3
  *segment 3 maneuver
    *integ dtprnt=0.1 dt=0.1
    *aero ca=0.0 cn=0.0
    *fly bankgd=15.0
    *when alt<0 stop
    *when tseg=35 goto 4
  *segment 4 terminal_pronav
    *integ dtprnt=0.5 dt=0.05
    *fly propnav=2
    *when relrng[2]<20000 stop
    *when alt<0 stop

*end
