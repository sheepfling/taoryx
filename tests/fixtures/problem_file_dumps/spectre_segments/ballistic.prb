(spectre-ballistic)

# Synthetic TAOS translation of INBOX/spectre-snippet-v1/simple_aero/ballistic.yaml
# Spectre family: ballistic
# Start controls: launch_point, aimpoint, initial_altitude_m, initial_speed_mps
# Stop controls: coast_time_s, optimization termination

*title Spectre translation ballistic

*atmos standard
*earth wgs-84 omega=0

*trajectory 1 vehicle start on 1
  *initial geodetic alt=0.0 long=14.4425 lat=35.8766 vel=10.0 gama=0.0 psi=90.0 time=0.0 mass=350.0
  *file ballistic.dat time alt vel gamgd alpha bankgd thrust
  *segment 1 ballistic
    *integ dtprnt=0.1 dt=0.1
    *aero ca=0.0 cn=0.0
    *prop thrust=609406.359 mdot=226.796
    *when time=60.0 stop

*end
